DATABASE_HOST='db'
DATABASE_PORT='3306'
DATABASE_NAME='database'
DATABASE_USER='user'
DATABASE_PASSWORD='password'

DEBUG='true'

ALLOWED_ORIGINS='http://localhost:3000'

# mock = OpenAI なし（ローカル検証）。openai = OPENAI_API_KEY 必須
TRIAGE_MODE='mock'
# OpenAI（TRIAGE_MODE=openai のとき）。自分の API キーを入れる。
OPENAI_API_KEY=''
# 任意。未設定なら gpt-4o-mini
OPENAI_MODEL='gpt-4o-mini'
