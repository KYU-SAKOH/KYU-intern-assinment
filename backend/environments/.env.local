DATABASE_HOST='db'
DATABASE_PORT='3306'
DATABASE_NAME='database'
DATABASE_USER='user'
DATABASE_PASSWORD='password'

DEBUG='true'

ALLOWED_ORIGINS='http://localhost:3000'

# トリアージ・再現支援に必須。本物のキーは .env.secret に書く（Git / Cursor AI から隠す）
# 空のまま。実キーは .env.secret で上書きする
GEMINI_API_KEY=''
# 任意。未設定なら gemini-3.5-flash-lite
GEMINI_MODEL='gemini-3.5-flash-lite'

# スタッフ通知: demo=ログのみ（既定）
NOTIFY_MODE='demo'
