DATABASE_HOST='db'
DATABASE_PORT='3306'
DATABASE_NAME='database'
DATABASE_USER='user'
DATABASE_PASSWORD='password'

DEBUG='true'

ALLOWED_ORIGINS='http://localhost:3000'

# mock = Gemini なし（ローカル検証）。gemini = GEMINI_API_KEY 必須
# 本物のキーは .env.secret に書く（Git / Cursor AI から隠す）
TRIAGE_MODE='gemini'
# 空のまま。実キーは .env.secret で上書きする
GEMINI_API_KEY=''
# 任意。未設定なら gemini-3.5-flash-lite
GEMINI_MODEL='gemini-3.5-flash-lite'
