DATABASE_HOST=''
DATABASE_PORT=''
DATABASE_NAME=''
DATABASE_USER=''
DATABASE_PASSWORD=''

DEBUG=''

# 許可するフロントエンドのオリジンをカンマ区切りで設定する（末尾スラッシュ不要）
# local: http://localhost:3000
ALLOWED_ORIGINS=''

# mock = Gemini なし（ローカル検証）。gemini = GEMINI_API_KEY 必須
TRIAGE_MODE=''
# 本物のキーは .env.secret に書く（.env.secret.example をコピー）
# .env.local の GEMINI_API_KEY は空のままでよい
GEMINI_API_KEY=''
# 任意。未設定なら gemini-3.5-flash-lite
GEMINI_MODEL='gemini-3.5-flash-lite'
